<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="database.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4934"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="contracts" custom_title="0" dock_id="1" table="4,9:maincontracts"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">PRAGMA foreign_keys = OFF;

DROP TABLE IF EXISTS files;
DROP TABLE IF EXISTS notes;
DROP TABLE IF EXISTS viewing_bookings;
DROP TABLE IF EXISTS transactions;
DROP TABLE IF EXISTS contracts;
DROP TABLE IF EXISTS tenants;
DROP TABLE IF EXISTS properties;
DROP TABLE IF EXISTS users;
DROP TABLE IF EXISTS landlords;

PRAGMA foreign_keys = ON;

CREATE TABLE landlords (
    landlord_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    phone TEXT NOT NULL,
    address TEXT NOT NULL,
    email TEXT NOT NULL,
    id_type TEXT NOT NULL,
    id_number TEXT NOT NULL,
    id_expiry_date TEXT NOT NULL,
    number_of_properties INTEGER NOT NULL,
    contact_method TEXT NOT NULL DEFAULT 'email',
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT
);

CREATE TABLE users (
    user_id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL,
    name TEXT NOT NULL,
    phone TEXT NOT NULL,
    email TEXT NOT NULL,
    password TEXT NOT NULL,
    password_reset_date TEXT NOT NULL,
    id_number TEXT NOT NULL,
    id_expiry_date TEXT NOT NULL,
    role TEXT NOT NULL CHECK (role IN ('admin','agent','read_only')),
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT
);

CREATE TABLE properties (
    property_id INTEGER PRIMARY KEY AUTOINCREMENT,
    property_address TEXT NOT NULL,
    property_type TEXT NOT NULL,
    monthly_rent REAL NOT NULL,
    landlord_id INTEGER NOT NULL,
    gas_cert_due TEXT NOT NULL,
    electric_cert_due TEXT NOT NULL,
    epc_due_date TEXT NOT NULL,
    landlord_id_expiry_date TEXT NOT NULL,
    room_count INTEGER NOT NULL,
    bathroom_count INTEGER NOT NULL,
    epc_rating TEXT NOT NULL CHECK (epc_rating IN ('A','B','C','D','E','F','G')),
    has_garden INTEGER NOT NULL CHECK (has_garden IN (0,1)),
    allowed_pets INTEGER NOT NULL CHECK (allowed_pets IN (0,1)),
    council_band TEXT NOT NULL CHECK (council_band IN ('A','B','C','D','E','F','G','H')),
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT,
    FOREIGN KEY (landlord_id) REFERENCES landlords(landlord_id)
);

CREATE TABLE tenants (
    tenant_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    phone TEXT NOT NULL,
    email TEXT NOT NULL,
    id_type TEXT NOT NULL,
    id_number TEXT NOT NULL,
    id_expiry_date TEXT NOT NULL,
    contact_method TEXT NOT NULL DEFAULT 'email',
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT
);

CREATE TABLE contracts (
    contract_id INTEGER PRIMARY KEY AUTOINCREMENT,
    tenant_id INTEGER,
    property_id INTEGER,
    landlord_id INTEGER,
    contract_start DATE NOT NULL,
    contract_end DATE NOT NULL,
    rent REAL NOT NULL,
    frequency TEXT NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),
    date_archived TEXT,
    FOREIGN KEY (property_id) REFERENCES properties(property_id),
    FOREIGN KEY (tenant_id) REFERENCES tenants(tenant_id),
    FOREIGN KEY (landlord_id) REFERENCES landlords(landlord_id)
);

CREATE TABLE transactions (
    transaction_id INTEGER PRIMARY KEY AUTOINCREMENT,
    tenant_id INTEGER NOT NULL,
    property_id INTEGER NOT NULL,
    transaction_amount REAL NOT NULL,
    date_of_transaction TEXT NOT NULL,
    payment_period TEXT NOT NULL,
    next_due TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('completed','pending','not complete')),
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT,
    FOREIGN KEY (tenant_id) REFERENCES tenants(tenant_id),
    FOREIGN KEY (property_id) REFERENCES properties(property_id)
);

CREATE TABLE notes (
    note_id INTEGER PRIMARY KEY AUTOINCREMENT,
    note_text TEXT NOT NULL,
    created_at TEXT NOT NULL,
    created_by TEXT,
    type TEXT,
    property_id INTEGER,
    landlord_id INTEGER,
    tenant_id INTEGER,
    payment_id INTEGER,
    viewing_id INTEGER,
    date_id INTEGER,
    user_id INTEGER,
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT,
    FOREIGN KEY (property_id) REFERENCES properties(property_id),
    FOREIGN KEY (landlord_id) REFERENCES landlords(landlord_id),
    FOREIGN KEY (tenant_id) REFERENCES tenants(tenant_id)
);

CREATE TABLE viewing_bookings (
    booking_id INTEGER PRIMARY KEY AUTOINCREMENT,
    property_id INTEGER NOT NULL,
    viewer_name TEXT NOT NULL,
    viewer_phone TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('scheduled','completed','cancelled','no_show')),
    date_time TEXT NOT NULL,
    user_id INTEGER NOT NULL,
    email VARCHAR(50) NOT NULL,
    archived INTEGER NOT NULL CHECK (archived IN (0,1)),
    date_archived TEXT,
    FOREIGN KEY (property_id) REFERENCES properties(property_id),
    FOREIGN KEY (user_id) REFERENCES users(user_id)
);


